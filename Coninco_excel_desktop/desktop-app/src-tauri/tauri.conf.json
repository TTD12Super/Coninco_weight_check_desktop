{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CONINCO Excel Auditor",
  "version": "0.2.0",
  "identifier": "com.coninco.excelauditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CONINCO Excel Auditor",
        "width": 1600,
        "height": 920,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": ["engine/*"]
  }
}
